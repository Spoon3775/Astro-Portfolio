---
// Particle background: ambient drifting particles plus a morphing "logo"
// made of particles, drawn in the hollow right side of the viewport.
---

<div id="bg-particles" class="fixed inset-0 -z-10" aria-hidden="true">
  <canvas id="bg-canvas" class="h-full w-full"></canvas>
  <!-- Soft gradient glow blobs layered under the particles -->
  <div class="pointer-events-none absolute -top-32 -left-32 h-96 w-96 rounded-full bg-emerald-500/10 blur-3xl"></div>
  <div class="pointer-events-none absolute top-1/3 -right-32 h-96 w-96 rounded-full bg-teal-500/10 blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-0 left-1/3 h-96 w-96 rounded-full bg-emerald-400/5 blur-3xl"></div>
</div>

<script>
  const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  // Offscreen canvas used to rasterize logos so we can sample their pixels.
  const off = document.createElement('canvas');
  const offCtx = off.getContext('2d', { willReadFrequently: true })!;

  type Particle = { x: number; y: number; vx: number; vy: number; tx?: number; ty?: number };
  type Point = { x: number; y: number };

  let particles: Particle[] = [];
  let targets: Point[] = [];
  let width = 0;
  let height = 0;
  let raf = 0;
  let animationStarted = false;
  let logoIndex = 0;
  let lastSwitch = 0;

  const LOGO_HOLD_MS = 7000; // how long each logo stays formed
  const EASE = 0.07; // easing factor toward target points
  const MAX_LOGO_PARTICLES = 800;

  const MOUSE_RADIUS = 140;
  const mouse = { x: -9999, y: -9999 };

  // Reduced-motion users get a static render only.
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // GitHub octocat mark (24x24 viewBox path) as a Path2D.
  const GITHUB_PATH = new Path2D(
    'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z'
  );

  function drawText(logo: string) {
    return (c: CanvasRenderingContext2D, w: number, h: number) => {
      const fontSize = Math.min(h * 0.85, w / (logo.length * 0.68));
      c.font = `bold ${fontSize}px ui-monospace, "Cascadia Mono", monospace`;
      c.textAlign = 'center';
      c.textBaseline = 'middle';
      c.fillText(logo, w / 2, h / 2);
    };
  }

  const LOGOS: ((c: CanvasRenderingContext2D, w: number, h: number) => void)[] = [
    drawText('</>'),
    drawText('{ }'),
    drawText('λ'),
    (c, w, h) => {
      // GitHub octocat, scaled from its 24x24 viewBox.
      const s = (Math.min(w, h) * 0.85) / 24;
      c.save();
      c.translate(w / 2 - 12 * s, h / 2 - 12 * s);
      c.scale(s, s);
      c.fill(GITHUB_PATH);
      c.restore();
    },
    drawText('git'),
  ];

  // Rasterize the current logo offscreen and sample filled pixels into
  // target points positioned in the hollow right side of the viewport.
  function buildTargets() {
    // Only draw the logo in the hollow right side on wide screens.
    if (width < 1024) {
      targets = [];
      return;
    }
    const rw = Math.max(200, width * 0.26);
    const rh = Math.max(200, height * 0.5);
    const rx = width - rw - width * 0.02;
    const ry = (height - rh) / 2;

    off.width = Math.floor(rw);
    off.height = Math.floor(rh);
    offCtx.clearRect(0, 0, off.width, off.height);
    offCtx.fillStyle = '#fff';
    LOGOS[logoIndex](offCtx, off.width, off.height);

    const data = offCtx.getImageData(0, 0, off.width, off.height).data;
    let step = 5;
    const sampled: Point[] = [];
    for (let y = 0; y < off.height; y += step) {
      for (let x = 0; x < off.width; x += step) {
        if (data[(y * off.width + x) * 4 + 3] > 128) {
          sampled.push({ x: rx + x, y: ry + y });
        }
      }
    }
    // Downsample if there are more points than we want particles for.
    if (sampled.length > MAX_LOGO_PARTICLES) {
      const keep = MAX_LOGO_PARTICLES / sampled.length;
      targets = sampled.filter(() => Math.random() < keep);
    } else {
      targets = sampled;
    }
    // Shuffle so morphs look organic rather than sweeping top-to-bottom.
    targets.sort(() => Math.random() - 0.5);
  }

  // Assign logo particles to target points; leftovers stay ambient.
  function assignTargets() {
    const needed = targets.length;
    while (particles.length < needed) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
      });
    }
    for (let i = 0; i < particles.length; i++) {
      const p = particles[i];
      if (i < needed) {
        p.tx = targets[i].x;
        p.ty = targets[i].y;
      } else {
        delete p.tx;
        delete p.ty;
      }
    }
  }

  function nextLogo(now: number) {
    logoIndex = (logoIndex + 1) % LOGOS.length;
    lastSwitch = now;
    buildTargets();
    assignTargets();
  }

  function resize() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
    // Ambient particle count scales with viewport size (capped for performance).
    const ambient = Math.min(Math.floor((width * height) / 22000), 90);
    particles = Array.from({ length: ambient }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * 0.4,
      vy: (Math.random() - 0.5) * 0.4,
    }));
    buildTargets();
    assignTargets();
    drawFrame(false, performance.now());
  }

  function drawFrame(animate: boolean, now: number) {
    ctx.clearRect(0, 0, width, height);

    const ambient: Particle[] = [];

    for (const p of particles) {
      if (p.tx !== undefined && p.ty !== undefined) {
        // Logo particle: ease toward its target point.
        if (animate) {
          p.x += (p.tx - p.x) * EASE;
          p.y += (p.ty - p.y) * EASE;
        }
        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.6, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(52, 211, 153, 0.9)';
        ctx.fill();
      } else {
        ambient.push(p);
      }
    }

    // Ambient particles drift and bounce; connect nearby ones with faint lines.
    for (const p of ambient) {
      if (animate) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        // Gentle attraction toward the mouse.
        const mdx = mouse.x - p.x;
        const mdy = mouse.y - p.y;
        const mdist = Math.hypot(mdx, mdy);
        if (mdist < MOUSE_RADIUS && mdist > 0.001) {
          p.vx += (mdx / mdist) * 0.008;
          p.vy += (mdy / mdist) * 0.008;
          p.vx = Math.max(-0.7, Math.min(0.7, p.vx));
          p.vy = Math.max(-0.7, Math.min(0.7, p.vy));
        }
      }

      ctx.beginPath();
      ctx.arc(p.x, p.y, 1.5, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(52, 211, 153, 0.4)';
      ctx.fill();
    }

    for (let i = 0; i < ambient.length; i++) {
      for (let j = i + 1; j < ambient.length; j++) {
        const dx = ambient[i].x - ambient[j].x;
        const dy = ambient[i].y - ambient[j].y;
        const dist = Math.hypot(dx, dy);
        if (dist < 130) {
          ctx.beginPath();
          ctx.moveTo(ambient[i].x, ambient[i].y);
          ctx.lineTo(ambient[j].x, ambient[j].y);
          ctx.strokeStyle = `rgba(52, 211, 153, ${0.14 * (1 - dist / 130)})`;
          ctx.lineWidth = 1;
          ctx.stroke();
        }
      }
    }

    if (animate) {
      if (now - lastSwitch > LOGO_HOLD_MS) nextLogo(now);
      raf = requestAnimationFrame((t) => drawFrame(true, t));
    }
  }

  function start() {
    if (animationStarted) return;
    animationStarted = true;
    if (!prefersReducedMotion) {
      lastSwitch = performance.now();
      raf = requestAnimationFrame((t) => drawFrame(true, t));
    }
  }

  window.addEventListener('resize', resize);
  window.addEventListener('mousemove', (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });
  window.addEventListener('mouseout', () => {
    mouse.x = -9999;
    mouse.y = -9999;
  });

  resize();
  // Defer animation start until the page is idle so it never blocks load.
  if ('requestIdleCallback' in window) {
    requestIdleCallback(start);
  } else {
    setTimeout(start, 200);
  }

  // Pause the loop when the tab is hidden to save battery.
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      cancelAnimationFrame(raf);
      animationStarted = false;
    } else {
      start();
    }
  });
</script>
